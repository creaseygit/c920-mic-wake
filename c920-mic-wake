#!/usr/bin/env python3
# Wake the Logitech C920 (046d:082d) microphone after it is plugged in.
#
# Why: the C920 mic can get stuck streaming pure digital silence under snd-usb-audio, a state
# that survives replugs. The sequence below (stream alt 1 with no class requests, then rate,
# mute and a volume sweep, then stream again) cleared it, after which snd-usb-audio works
# normally. Running it on every plug-in guards against the state coming back. Diagnosed 2026-09-30; see REPORT.md in
# https://github.com/creaseygit/c920-mic-wake
#
# Usage (run by udev via systemd-run, as root): c920-mic-wake <usb-port e.g. 1-5> </dev/bus/usb/BBB/DDD>
import ctypes, fcntl, os, struct, sys, time

PORT, DEV = sys.argv[1], sys.argv[2]
AS_IF, AC_IF, EP = 3, 2, 0x82
NPK, PKT = 8, 68                                  # alt 1 = 16 kHz stereo s16, wMaxPacketSize 68
DRV = "/sys/bus/usb/drivers/snd-usb-audio"
SETINTERFACE, CLAIM, RELEASE = 0x80085504, 0x8004550F, 0x80045510
SUBMITURB, REAPURB, REAPURBNDELAY, DISCARD = 0x8038550A, 0x4008550C, 0x4008550D, 0x0000550B
CONTROL, FU = 0xC0185500, 5

class IsoDesc(ctypes.Structure):
    _fields_ = [("length", ctypes.c_uint), ("actual_length", ctypes.c_uint), ("status", ctypes.c_uint)]
class Urb(ctypes.Structure):
    _fields_ = [("type", ctypes.c_uint8), ("endpoint", ctypes.c_uint8), ("status", ctypes.c_int),
                ("flags", ctypes.c_uint), ("buffer", ctypes.c_void_p), ("buffer_length", ctypes.c_int),
                ("actual_length", ctypes.c_int), ("start_frame", ctypes.c_int),
                ("number_of_packets", ctypes.c_int), ("error_count", ctypes.c_int),
                ("signr", ctypes.c_uint), ("usercontext", ctypes.c_void_p), ("iso", IsoDesc * NPK)]
class Ctrl(ctypes.Structure):
    _fields_ = [("bRequestType", ctypes.c_uint8), ("bRequest", ctypes.c_uint8), ("wValue", ctypes.c_uint16),
                ("wIndex", ctypes.c_uint16), ("wLength", ctypes.c_uint16), ("timeout", ctypes.c_uint32),
                ("data", ctypes.c_void_p)]

def log(msg):
    print(f"c920-mic-wake: {msg}", flush=True)

def sysfs(path, value):
    try:
        with open(path, "w") as f:
            f.write(value)
    except OSError:
        pass

ifaces = [f"{PORT}:1.{AC_IF}", f"{PORT}:1.{AS_IF}"]
for _ in range(30):                               # let snd-usb-audio finish probing first
    if os.path.exists(f"{DRV}/{ifaces[0]}"):
        break
    time.sleep(0.1)
time.sleep(0.5)
for i in reversed(ifaces):
    sysfs(f"{DRV}/unbind", i)

libc = ctypes.CDLL(None, use_errno=True)
libc.ioctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_void_p]
fd = os.open(DEV, os.O_RDWR)
def pioctl(req, ptr):
    if libc.ioctl(fd, req, ptr) < 0:
        e = ctypes.get_errno(); raise OSError(e, os.strerror(e))

def ctl(rt, req, val, idx, payload=b"", length=0):
    buf = ctypes.create_string_buffer(payload, max(len(payload), length, 1))
    c = Ctrl(rt, req, val, idx, max(len(payload), length), 1000, ctypes.addressof(buf))
    try:
        fcntl.ioctl(fd, CONTROL, c)
    except OSError:
        pass

def stream(seconds):
    """Stream alt 1 for `seconds`; return (packets, non-zero packets)."""
    fcntl.ioctl(fd, SETINTERFACE, struct.pack("II", AS_IF, 1))
    by_addr, ptr, n, nz = {}, ctypes.c_void_p(), 0, 0
    for _ in range(4):
        b = ctypes.create_string_buffer(NPK * PKT)
        u = Urb(type=0, endpoint=EP, flags=2, buffer=ctypes.addressof(b), buffer_length=NPK * PKT,
                number_of_packets=NPK)
        for i in range(NPK):
            u.iso[i].length = PKT
        by_addr[ctypes.addressof(u)] = (u, b)
        pioctl(SUBMITURB, ctypes.addressof(u))
    end = time.time() + seconds
    while True:
        pioctl(REAPURB, ctypes.addressof(ptr))
        u, b = by_addr[ptr.value]
        for i in range(NPK):
            al = u.iso[i].actual_length
            n += 1
            nz += any(b.raw[i * PKT:i * PKT + al])
            u.iso[i].actual_length = u.iso[i].status = 0
        if time.time() > end:
            break
        pioctl(SUBMITURB, ctypes.addressof(u))
    for addr in by_addr:
        try: pioctl(DISCARD, addr)
        except OSError: pass
    deadline = time.time() + 1
    while time.time() < deadline:
        try: pioctl(REAPURBNDELAY, ctypes.addressof(ptr))
        except OSError: time.sleep(0.02)
    fcntl.ioctl(fd, SETINTERFACE, struct.pack("II", AS_IF, 0))
    return n, nz

FU_IDX = (FU << 8) | AC_IF
n1 = nz1 = n2 = nz2 = 0
try:
    fcntl.ioctl(fd, CLAIM, struct.pack("I", AC_IF))
    fcntl.ioctl(fd, CLAIM, struct.pack("I", AS_IF))
    fcntl.ioctl(fd, SETINTERFACE, struct.pack("II", AS_IF, 0))
    n1, nz1 = stream(0.5)                                    # Windows way: no class requests first
    ctl(0xA2, 0x81, 0x0100, EP, length=3)                    # GET sample rate
    ctl(0x22, 0x01, 0x0100, EP, (16000).to_bytes(3, "little"))  # SET sample rate 16 kHz
    ctl(0x21, 0x01, 0x0100, FU_IDX, b"\x00")                 # unmute
    ctl(0xA1, 0x81, 0x0200, FU_IDX, length=2)                # GET volume
    for v in (12800, 5120, 9216):                            # volume max, min, 36 dB
        ctl(0x21, 0x01, 0x0200, FU_IDX, struct.pack("<h", v))
    n2, nz2 = stream(0.3)
finally:
    for i in (AS_IF, AC_IF):
        try: fcntl.ioctl(fd, RELEASE, struct.pack("I", i))
        except OSError: pass
    os.close(fd)
    sysfs(f"{DRV}/bind", ifaces[0])               # binding the control interface re-probes the card
    log(f"woke {PORT} ({DEV}): {nz1}/{n1} then {nz2}/{n2} packets non-zero during warm-up; snd-usb-audio re-bound")
